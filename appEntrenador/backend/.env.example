# Copiar a .env y ajustar. No commitear .env.
NODE_ENV=development
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
PORT=3000

# MySQL (local XAMPP por defecto; en Render/TiDB usa tu DB gestionada)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coach_db
# TiDB Serverless ejemplo:
# DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=xxxx.root
# DB_PASSWORD=
# DB_NAME=coach_db
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

# Frontend público (reset password + CORS)
APP_PUBLIC_URL=http://localhost:5173
# Orígenes permitidos separados por coma (Workers.dev, túnel, etc.).
# En desarrollo, localhost:5173/4173 se añaden solos aunque no estén aquí.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Resend Free Tier — SMTP (Nodemailer; no requiere SDK)
# Host/user fijos; SMTP_PASS = API key (re_...)
# onboarding@resend.dev solo envía al email de la cuenta Resend.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_PEGA_AQUI_TU_API_KEY
SMTP_FROM=Trainfit <noreply@trainfit.co>

# Cloudflare R2 — solo fotos de perfil (avatares). Free tier Standard.
# Si faltan estas 4 vars, Multer guarda en disco local (dev / sin R2).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=trainfit-avatars
# Opcional (default: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com)
# R2_ENDPOINT=

# USDA FoodData Central — autocompletado nutricional (Feature 069).
# Key gratuita: https://api.data.gov/signup/
# NO uses DEMO_KEY en diario: tiene rate-limit agresivo (HTTP 429).
# USDA_FDC_API_KEY= heRmkHmYBSlatLvOlgADHQkB7OrXgK211JAsNzzS

# Web Push VAPID (Feature 051 — PWA). Generar: npm run vapid:generate
# Sin estas claves el API omite envíos push y GET /push/vapid-public-key responde 503.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@trainfit.co
